APP_ENV=production
PROJECT_NAME="Clone Memory Synchronizer"
DEBUG=false

POSTGRES_USER=synclone_production
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=synclone_production

JWT_SECRET_KEY=YOUR_GENERATED_KEY
JWT_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+asyncpg://synclone_production:PASSWORD@db:5432/synclone_production

CORS_ORIGINS=https://your-frontend-domain.example

# Optional: set all three values to create the first admin once.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password
# INITIAL_ADMIN_NAME=Synclone Administrator
