# Приклад змінних середовища Synclone.
# Скопіюйте файл у .env та змініть за потреби.

# URL реляційної бази даних (за замовчуванням — локальний SQLite)
DATABASE_URL=sqlite:///./synclone.db

# Варіант для PostgreSQL (драйвер psycopg2-binary уже встановлено):
# DATABASE_URL=postgresql+psycopg2://synclone:password@localhost:5432/synclone

DEBUG=true
