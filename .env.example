# Database credentials (change before deployment)
POSTGRES_USER=synclone
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=synclone

# Must be a long random secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# Bootstrap administrator created on first startup if not already present
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-this-admin-password
INITIAL_ADMIN_NAME=Synclone Administrator

# Frontend origin; comma-separated if more than one
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql+asyncpg://synclone:change-this-db-password@db:5432/synclone
