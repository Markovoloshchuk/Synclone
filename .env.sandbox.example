APP_ENV=sandbox
PROJECT_NAME="Clone Memory Synchronizer"
DEBUG=true

POSTGRES_USER=synclone_sandbox
POSTGRES_PASSWORD=sandbox_local_password
POSTGRES_DB=synclone_sandbox

JWT_SECRET_KEY=YOUR_GENERATED_KEY
JWT_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+asyncpg://synclone_sandbox:sandbox_local_password@db:5432/synclone_sandbox

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: set all three values to create the first admin once.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password
# INITIAL_ADMIN_NAME=Synclone Administrator
